      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\n    USER[\&quot;User / Browser\&quot;]\n\n    GATEWAY[\&quot;API Gateway\&quot;]\n\n    subgraph CREATION[\&quot;URL CREATION FLOW\&quot;]\n\n        SERVICE[\&quot;URL Creation Service\&quot;]\n\n        GENERATOR[\&quot;Base62 Code Generator\&quot;]\n\n        DATABASE1[(\&quot;PostgreSQL\&quot;)]\n\n        CACHE1[(\&quot;Redis\&quot;)]\n\n        RESULT[\&quot;Return Short URL\&quot;]\n\n        SERVICE --&gt; GENERATOR\n        GENERATOR --&gt; SERVICE\n        SERVICE --&gt; DATABASE1\n        SERVICE --&gt; CACHE1\n        CACHE1 --&gt; RESULT\n    end\n\n    subgraph REDIRECTION[\&quot;URL REDIRECTION FLOW\&quot;]\n\n        REDIRECT[\&quot;Redirect Service\&quot;]\n\n        CACHE2[(\&quot;Redis Cache\&quot;)]\n\n        CHECK{\&quot;Short Code Found?\&quot;}\n\n        DATABASE2[(\&quot;PostgreSQL\&quot;)]\n\n        REDIRECTED[\&quot;HTTP 302 Redirect\&quot;]\n\n        REDIRECT --&gt; CACHE2\n        CACHE2 --&gt; CHECK\n        CHECK --&gt;|\&quot;YES\&quot;| REDIRECTED\n        CHECK --&gt;|\&quot;NO\&quot;| DATABASE2\n        DATABASE2 --&gt; CACHE2\n    end\n\n    USER --&gt;|\&quot;POST /api/v1/urls\&quot;| GATEWAY\n    GATEWAY --&gt; SERVICE\n    RESULT --&gt; USER\n\n    USER --&gt;|\&quot;GET /shortCode\&quot;| GATEWAY\n    GATEWAY --&gt; REDIRECT\n    REDIRECTED --&gt; USER&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="7iPLvzANToT7ixY3_wNl-1">
